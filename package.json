{
  "name": "drsoltantouye",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @clinic/shared build && turbo dev",
    "build": "turbo build",
    "db:up": "docker compose up -d",
    "db:setup": "pnpm --filter api exec prisma migrate deploy && pnpm --filter api db:seed",
    "prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build"
  },
  "devDependencies": {
    "turbo": "2.11.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
